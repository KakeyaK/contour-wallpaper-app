<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/picker_swatch"
            android:layout_width="56dp"
            android:layout_height="56dp" />

        <EditText
            android:id="@+id/picker_hex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:hint="#RRGGBB"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="7"
            android:maxLines="1"
            android:typeface="monospace" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Hue" android:textSize="12sp" />
    <SeekBar android:id="@+id/seek_h" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:max="360" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Saturation" android:textSize="12sp" />
    <SeekBar android:id="@+id/seek_s" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:max="100" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Brightness" android:textSize="12sp" />
    <SeekBar android:id="@+id/seek_v" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:max="100" />
</LinearLayout>
